{
  "manifest_version": 3,
  "name": "LeetCode Coach Link",
  "version": "0.1.0",
  "description": "Sends your leetcode.com submissions (code, language, verdict) to your local coaching app. Never sends problem statements.",
  "permissions": ["storage"],
  "host_permissions": ["https://leetcode.com/*", "http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["page.js"], "matches": ["https://leetcode.com/*"] }
  ],
  "action": { "default_title": "LeetCode Coach", "default_popup": "popup.html" }
}
